---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import GithubLogo from '../components/GithubLogo.astro';
import NotionLogo from '../components/NotionLogo.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import { CONTACT, CV, FILES } from '../data/cv.mjs';

interface Props { lang: 'en' | 'uk' }
const { lang } = Astro.props;
const d = CV[lang];
const f = FILES[lang];
const home = lang === 'uk' ? '/uk/' : '/';

const T = {
  en: {
    title: 'Bohdan N. · Senior Project Manager, Fintech Delivery',
    desc: 'Senior Project Manager, 7+ years in IT delivery. Took a fintech payments product to live production with 50,000+ users. Author of PM Control Tower.',
    skip: 'Skip to content',
    nav: { case: 'Case', tower: 'Control Tower', experience: 'Experience', skills: 'Skills', contact: 'Contact' },
    theme: 'Switch light or dark theme',
    menu: 'Menu',
    langLabel: 'Language',
    cv: 'CV', cvGroup: 'Download CV', pdf: 'PDF', docx: 'DOCX',
    heroEyebrow: 'Uzhhorod · Remote · EET',
    claim: 'From unclear scope to stable production.',
    lead: '<strong>From unclear scope to stable production.</strong> 7+ years in IT delivery, most recently on a fintech payments product for an enterprise client in Latin America: I set the real scope, took it to live production with 50,000+ users and led a cross-functional team of 13 through a full handover. I also build and open-source the tooling I run projects with.',
    ctaTalk: 'Get in touch',
    ctaPdf: 'CV · PDF',
    ctaDocx: 'CV · Word',
    contactsLabel: 'Contacts',
    strip: {
      url: 'delivery-log · fintech payments · LatAm',
      label: 'Flight strip · fintech',
      live: 'Live',
      rows: [
        ['Status', '<b>In production</b> · card infrastructure', true],
        ['Users', '<b>50,000+</b>', false],
        ['Team', '<b>13</b> · cross-functional', false],
        ['Method', '<b>Hybrid Agile</b> + fixed scope', false],
        ['Handover', '<b>Done</b> · auth stream ongoing', false],
      ],
      route: 'Route',
      steps: ['Discovery', 'Scope', 'Build', 'Live', 'Handover'],
      caption: 'Snapshot of the delivery I led.',
    },
    stats: [
      ['~7 yrs', 'in IT delivery', 'since 2019'],
      ['50,000+', 'users on a product I took to production', 'fintech · payments'],
      ['13', 'people in the cross-functional team I led', 'through full handover'],
      ['up to 20', 'people in distributed teams I coordinated', 'fixed-price and T&M'],
    ],
    caseEyebrow: 'Projects · Selected case',
    caseH: 'Reset the scope, shipped it, handed it over',
    caseAside: 'Fintech payments product for an enterprise client in Latin America. Client and product stay confidential.',
    phases: [
      ['Before me', 'Discovery', 'Initial discovery and sale, scope still unclear', 'past'],
      ['Scope', 'Reset', 'What was sold against what the client needed', ''],
      ['Build', 'Hybrid', 'Agile and fixed-scope phases, one plan', ''],
      ['Live', 'Production', 'Card infrastructure, real users', ''],
      ['Handover', 'In-house', 'Team moved to the client, production stable', 'done'],
    ],
    beats: [
      ['01 · Situation', 'Scope that did not match', 'I joined after discovery. What had been sold and what the client actually needed did not line up, and the product was at an early build stage.'],
      ['02 · What I did', 'One plan, one voice', 'Set the real scope, turned requirements into prioritized work, covered analyst and product owner duties, and stayed the single point of contact. When scope spiked, the client saw the trade-offs before anything moved.'],
      ['03 · Outcome', 'Live, then handed over', 'The product runs on card infrastructure with 50,000+ users. When development moved in-house, I led a structured handover of the team and production stayed stable.'],
    ],
    ct: {
      ver: 'v1.6.1 · beta · MIT',
      h: 'I built the system I run delivery with',
      p: 'An open-source Claude plugin and Notion template for project managers. It collects context, preps meetings, drafts reports and tracks risks on daily, weekly and monthly schedules, and gives live tips during calls. Every project fact sits in one config file, and a human approves every outgoing message.',
      note: 'Built and used daily on a live client project.',
      visit: 'Visit tower.bodco.pm', gh: 'GitHub', notion: 'Notion template',
      counts: [['22', 'Claude skills, project-agnostic'], ['11', 'linked Notion databases'], ['1', 'config file per project']],
      log: [
        ['daily', 'work report, reply drafts', 'scheduled'],
        ['weekly', 'overview across projects', 'scheduled'],
        ['monthly', 'client report draft', 'scheduled'],
        ['on call', 'live tips co-pilot', 'live'],
        ['always', 'a human approves every message', 'gate'],
      ],
    },
    xpH: 'In delivery since 2019',
    skillsH: 'What I bring to delivery',
    howEyebrow: 'How I work',
    howH: 'Four habits behind the delivery',
    how: [
      ['No surprises for the client', 'Risks and scope changes reach the client from me, early and with the options on the table.'],
      ['Trade-offs before work starts', 'When scope grows, the client sees what moves and what it costs, then decides.'],
      ['One source of truth', 'Every project fact lives in one place, not in my head.'],
      ['Built to be handed over', 'Priorities, decisions and access are documented as we go, so the team and the system can run without me.'],
    ],
    credEyebrow: 'Education · Certifications · Languages',
    contactH: 'Write to me',
    contactP: 'Telegram is the quickest way to reach me. Email and LinkedIn work too.',
    cvPdf: 'CV · PDF', cvDocx: 'CV · Word',
    footerAbout: 'Senior Project Manager · Uzhhorod, Ukraine',
    footerAlso: 'Also by me',
    footerContact: 'Contact',
    footerFiles: 'CV files',
    footerLine: '© 2026 Bohdan N. · Built on the PM Control Tower design system',
    towerSite: 'PM Control Tower site', towerRepo: 'GitHub repository', towerNotion: 'Notion template',
    pdfEn: 'PDF (English)', docxEn: 'Word (English)', pdfUk: 'PDF (Ukrainian)', docxUk: 'Word (Ukrainian)',
  },
  uk: {
    title: 'Bohdan N. · Senior Project Manager, delivery у фінтеху',
    desc: 'Senior Project Manager, 7+ років в IT delivery. Вивів платіжний фінтех-продукт у продакшн, 50 000+ користувачів. Автор PM Control Tower.',
    skip: 'Перейти до змісту',
    nav: { case: 'Кейс', tower: 'Control Tower', experience: 'Досвід', skills: 'Навички', contact: 'Контакти' },
    theme: 'Світла або темна тема',
    menu: 'Меню',
    langLabel: 'Мова',
    cv: 'CV', cvGroup: 'Завантажити CV', pdf: 'PDF', docx: 'DOCX',
    heroEyebrow: 'Ужгород · віддалено · EET',
    claim: 'Від розмитого скоупу до стабільного продакшену.',
    lead: '<strong>Від розмитого скоупу до стабільного продакшену.</strong> 7+ років в IT delivery, останні роки на платіжному фінтех-продукті для enterprise-клієнта з Латинської Америки: зафіксував справжній скоуп, вивів продукт у продакшн з 50 000+ користувачів і провів крос-функціональну команду з 13 людей до повного handover. Інструменти, з якими веду проєкти, будую сам і відкриваю в open source.',
    ctaTalk: 'Зв’язатися',
    ctaPdf: 'CV · PDF',
    ctaDocx: 'CV · Word',
    contactsLabel: 'Контакти',
    strip: {
      url: 'delivery-log · fintech payments · LatAm',
      label: 'Flight strip · fintech',
      live: 'Live',
      rows: [
        ['Статус', '<b>У продакшені</b> · карткова інфраструктура', true],
        ['Користувачі', '<b>50 000+</b>', false],
        ['Команда', '<b>13</b> · крос-функціональна', false],
        ['Метод', '<b>Hybrid Agile</b> + fixed scope', false],
        ['Передача', '<b>Завершено</b> · авторизацію веду далі', false],
      ],
      route: 'Маршрут',
      steps: ['Discovery', 'Скоуп', 'Розробка', 'Прод', 'Передача'],
      caption: 'Знімок delivery, який я вів.',
    },
    stats: [
      ['~7 р.', 'в IT delivery', 'з 2019 року'],
      ['50 000+', 'користувачів продукту, який я вивів у продакшн', 'фінтех · платежі'],
      ['13', 'людей у крос-функціональній команді', 'до повного handover'],
      ['до 20', 'людей у розподілених командах', 'fixed-price і T&M'],
    ],
    caseEyebrow: 'Проєкти · вибраний кейс',
    caseH: 'Перезібрав скоуп, вивів у прод, передав команду',
    caseAside: 'Платіжний фінтех-продукт для enterprise-клієнта з Латинської Америки. Клієнт і продукт конфіденційні.',
    phases: [
      ['До мене', 'Discovery', 'Перший discovery і продаж, скоуп ще розмитий', 'past'],
      ['Скоуп', 'Перезбірка', 'Що продали і що клієнту насправді потрібно', ''],
      ['Розробка', 'Гібрид', 'Agile і fixed-scope фази в одному плані', ''],
      ['Прод', 'Продакшн', 'Карткова інфраструктура, реальні користувачі', ''],
      ['Передача', 'In-house', 'Команда перейшла до клієнта, прод стабільний', 'done'],
    ],
    beats: [
      ['01 · Ситуація', 'Скоуп, що не збігався', 'Я прийшов після discovery. Продане і реально потрібне клієнту не збігалося, продукт був на ранній стадії розробки.'],
      ['02 · Що я зробив', 'Один план, один голос', 'Зафіксував справжній скоуп, перетворив вимоги на пріоритезовані задачі, закривав ролі аналітика і product owner, був єдиною точкою контакту. Коли скоуп ріс, клієнт бачив компроміси до того, як щось зсувалось.'],
      ['03 · Результат', 'Продакшн, потім передача', 'Продукт працює на картковій інфраструктурі з 50 000+ користувачів. Коли розробка пішла in-house, я провів структурований handover команди, прод залишився стабільним.'],
    ],
    ct: {
      ver: 'v1.6.1 · beta · MIT',
      h: 'Я зібрав систему, якою веду delivery',
      p: 'Open-source Claude-плагін і Notion-шаблон для проєктних менеджерів. Збирає контекст, готує до мітингів, пише чернетки звітів і веде ризики за щоденним, тижневим і місячним розкладом, а під час дзвінків дає підказки. Усі факти про проєкт живуть в одному конфіг-файлі, кожне вихідне повідомлення погоджує людина.',
      note: 'Створений і щодня працює на живому клієнтському проєкті.',
      visit: 'Перейти на tower.bodco.pm', gh: 'GitHub', notion: 'Notion-шаблон',
      counts: [['22', 'Claude skills, не прив’язані до проєкту'], ['11', 'пов’язаних баз у Notion'], ['1', 'конфіг-файл на проєкт']],
      log: [
        ['daily', 'звіт за день, чернетки відповідей', 'scheduled'],
        ['weekly', 'огляд усіх проєктів', 'scheduled'],
        ['monthly', 'чернетка звіту клієнту', 'scheduled'],
        ['on call', 'підказки під час дзвінка', 'live'],
        ['always', 'кожне повідомлення погоджує людина', 'gate'],
      ],
    },
    xpH: 'У delivery з 2019 року',
    skillsH: 'З чим я приходжу на проєкт',
    howEyebrow: 'Як я працюю',
    howH: 'Чотири звички, на яких тримається delivery',
    how: [
      ['Жодних сюрпризів для клієнта', 'Про ризики і зміни скоупу клієнт дізнається від мене, рано і разом з варіантами рішень.'],
      ['Компроміси до старту роботи', 'Коли скоуп росте, клієнт бачить, що зсувається і скільки це коштує, і тоді вирішує.'],
      ['Одне джерело правди', 'Кожен факт про проєкт живе в одному місці, а не в моїй голові.'],
      ['Будую так, щоб можна було передати', 'Пріоритети, рішення і доступи документуються по ходу роботи, тож команда і система працюють і без мене.'],
    ],
    credEyebrow: 'Освіта · сертифікати · мови',
    contactH: 'Напишіть мені',
    contactP: 'Найшвидше відповідаю в Telegram. Також можна написати на email або в LinkedIn.',
    cvPdf: 'CV · PDF', cvDocx: 'CV · Word',
    footerAbout: 'Senior Project Manager · Ужгород, Україна',
    footerAlso: 'Також моє',
    footerContact: 'Контакти',
    footerFiles: 'Файли CV',
    footerLine: '© 2026 Bohdan N. · Зроблено на дизайн-системі PM Control Tower',
    towerSite: 'Сайт PM Control Tower', towerRepo: 'Репозиторій на GitHub', towerNotion: 'Notion-шаблон',
    pdfEn: 'PDF (англійською)', docxEn: 'Word (англійською)', pdfUk: 'PDF (українською)', docxUk: 'Word (українською)',
  },
}[lang];

const contacts = [
  { key: 'telegram', label: 'Telegram', value: CONTACT.telegram.handle, href: CONTACT.telegram.url, main: true },
  { key: 'linkedin', label: 'LinkedIn', value: CONTACT.linkedin.handle, href: CONTACT.linkedin.url },
  { key: 'github', label: 'GitHub', value: CONTACT.github.handle, href: CONTACT.github.url },
  { key: 'mail', label: 'Email', value: CONTACT.email, href: `mailto:${CONTACT.email}` },
] as const;
---
<Base lang={lang} title={T.title} description={T.desc}>
  <a class="skip" href="#main">{T.skip}</a>
  <header class="site-header">
    <nav class="nav wrap" aria-label="Main" data-open="false">
      <a class="brand" href="#top" aria-label={`${CONTACT.name}`}><Mark /><span>{CONTACT.name}</span></a>
      <ul class="nav__links" id="nav-links">
        {Object.entries(T.nav).map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ul>
      <div class="nav__tools">
        <div class="lang" role="group" aria-label={T.langLabel}>
          <a href="/" hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          <a href="/uk/" hreflang="uk" lang="uk" aria-current={lang === 'uk' ? 'true' : undefined}>UK</a>
        </div>
        <button class="theme-btn" type="button" aria-label={T.theme} title={T.theme}>
          <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
          <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a class="gh tower-link" href={CONTACT.tower}><span class="brand__emoji" aria-hidden="true">🗼</span><span>Control Tower</span></a>
        <button class="menu-btn" type="button" aria-controls="nav-links" aria-expanded="false" aria-label={T.menu}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </nav>
  </header>

  <main id="main">
    <!-- Hero + summary -->
    <section class="wrap hero" id="top" aria-labelledby="name-h">
      <div class="split hero__in">
        <div class="stack hero__text">
          <p class="eyebrow eyebrow--muted">{T.heroEyebrow}</p>
          <h1 class="hero__h1" id="name-h">
            <span class="hero__name">{CONTACT.name}</span>
            <span class="hero__role">{d.title}</span>
          </h1>
          <p class="print-only print-contacts">{CONTACT.email} · t.me/bodco · linkedin.com/in/bneymet · github.com/bodco · {d.location}</p>
          <h2 class="sr-only" data-print-title={d.h.summary}><span>{d.h.summary}</span></h2>
          <p class="lead hero__lead" set:html={T.lead} />
          <div class="btns">
            <a class="btn btn--primary" href="#contact">{T.ctaTalk} <Arrow /></a>
            <a class="btn" href={f.pdf} download type="application/pdf"><Icon name="download" size={18} /> {T.ctaPdf}</a>
            <a class="btn" href={f.docx} download type="application/vnd.openxmlformats-officedocument.wordprocessingml.document"><Icon name="download" size={18} /> {T.ctaDocx}</a>
          </div>
          <ul class="icons" aria-label={T.contactsLabel}>
            {contacts.map((c) => <li><a href={c.href} aria-label={`${c.label}: ${c.value}`} title={`${c.label}: ${c.value}`}><Icon name={c.key} /></a></li>)}
          </ul>
        </div>
        <figure class="hero__visual">
          <div class="mock strip">
            <div class="mock__bar" aria-hidden="true">
              <span class="mock__dot"></span><span class="mock__dot"></span><span class="mock__dot"></span>
              <span class="mock__url">{T.strip.url}</span>
            </div>
            <div class="mock__body">
              <div class="strip__head">
                <span class="mock__label">{T.strip.label.toUpperCase()}</span>
                <span class="strip__live"><i class="pulse" aria-hidden="true"></i>{T.strip.live.toUpperCase()}</span>
              </div>
              <dl class="strip__rows">
                {T.strip.rows.map(([k, v, ok]) => (
                  <div class={`strip__row${ok ? ' strip__row--ok' : ''}`}><dt>{k}</dt><dd set:html={v} /></div>
                ))}
              </dl>
              <span class="mock__label">{T.strip.route.toUpperCase()}</span>
              <ol class="strip__route">
                {T.strip.steps.map((s, i) => <li style={`--i:${i}`} data-state={i === 0 ? 'past' : i === 4 ? 'now' : undefined}>{s}</li>)}
              </ol>
            </div>
          </div>
          <figcaption class="mock-caption">{T.strip.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- At a glance -->
    <section class="band" aria-label={lang === 'uk' ? 'Коротко' : 'At a glance'} data-print="hide">
      <div class="wrap section--tight">
        <div class="grid grid--seams" style="--min: 220px;">
          {T.stats.map(([b, s, small]) => <div class="stat"><b>{b}</b> <span>{s}</span> <small>{small}</small></div>)}
        </div>
      </div>
    </section>

    <!-- Selected case -->
    <section class="wrap section" id="case" aria-labelledby="case-h" data-print="hide">
      <div class="head-row">
        <div class="stack" style="gap: 16px; max-width: 720px;">
          <p class="eyebrow" aria-hidden="true">{T.caseEyebrow}</p>
          <h2 id="case-h" class="h2"><span class="sr-only">{d.h.projects}: </span><span>{T.caseH}</span></h2>
        </div>
        <p class="muted head-aside">{T.caseAside}</p>
      </div>
      <ol class="phases">
        {T.phases.map(([code, b, s, state]) => <li data-state={state || undefined}><code>{code}</code><b>{b}</b><span>{s}</span></li>)}
      </ol>
      <div class="grid" style="--min: 280px;">
        {T.beats.map(([tag, title, text], i) => (
          <article class={`card${i === 2 ? ' card--accent' : ''}`}>
            <span class="card__tag">{tag}</span>
            <h3 class="card__title">{title}</h3>
            <p class="card__text">{text}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- PM Control Tower -->
    <section class="band" id="tower" aria-labelledby="tower-h">
      <div class="wrap section">
        <div class="ct">
          <div class="ct__text stack">
            <p class="ct__brand"><span class="brand__emoji" aria-hidden="true">🗼</span> PM Control Tower <span class="ct__ver">{T.ct.ver}</span></p>
            <h2 id="tower-h" class="h2 h2--sm" data-print-title={d.h.projects}><span class="sr-only">{d.h.projects}: </span><span>{T.ct.h}</span></h2>
            <p class="print-only"><b>PM Control Tower</b> · {d.project.meta}</p>
            <p class="muted ct__p">{T.ct.p}</p>
            <p class="ct__note"><span class="pulse" aria-hidden="true"></span>{T.ct.note}</p>
            <p class="print-only">{d.project.links}</p>
            <div class="btns ct__btns">
              <a class="btn btn--primary" href={CONTACT.tower}>{T.ct.visit} <Arrow /></a>
              <a class="more" href={CONTACT.towerRepo}><GithubLogo /> {T.ct.gh} <Arrow /></a>
              <a class="more" href={CONTACT.towerNotion}><NotionLogo /> {T.ct.notion} <Arrow /></a>
            </div>
          </div>
          <figure class="codefig ct__console" aria-label="PM Control Tower">
            <figcaption><a href={CONTACT.tower}>tower.bodco.pm ↗</a><span>v1.6.1 beta</span></figcaption>
            <div class="ct__counts">
              {T.ct.counts.map(([b, s]) => <div><b>{b}</b><span>{s}</span></div>)}
            </div>
            <ul class="ct__log">
              {T.ct.log.map(([c, s, e], i) => <li class={i === T.ct.log.length - 1 ? 'ct__log--gate' : undefined}><code>{c}</code><span>{s}</span><em>{e}</em></li>)}
            </ul>
          </figure>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section class="wrap section" id="experience" aria-labelledby="xp-h">
      <div class="head-row">
        <div class="stack" style="gap: 16px; max-width: 720px;">
          <p class="eyebrow" aria-hidden="true">{d.h.experience}</p>
          <h2 id="xp-h" class="h2" data-print-title={d.h.experience}><span class="sr-only">{d.h.experience}: </span><span>{T.xpH}</span></h2>
        </div>
      </div>
      <ol class="xp">
        {d.roles.map((r, i) => (
          <li>
            <article class="xp__role" data-current={i === 0 ? '' : undefined} aria-labelledby={`xp-${i}`}>
              <div class="xp__meta">
                <p class="xp__when"><time datetime={r.start}>{r.start}</time> - {r.end === '2022' ? <time datetime="2022">2022</time> : <span>{r.end}</span>}</p>
                <p class="xp__where">{r.where}</p>
              </div>
              <div class="xp__body">
                <h3 id={`xp-${i}`} class="xp__title">{r.title}<span class="sr-only">, </span><span class="xp__at">{r.company}</span></h3>
                <p class="xp__lead">{r.lead}</p>
                {r.groups.map((g) => (
                  <div class="xp__group">
                    <h4 class="label">{g.name}</h4>
                    <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
                  </div>
                ))}
                <ul class="chips chips--sm xp__tags" aria-label={lang === 'uk' ? 'Ключові слова' : 'Keywords'}>{r.tags.map((t) => <li>{t}</li>)}</ul>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <!-- Skills -->
    <section class="band" id="skills" aria-labelledby="skills-h">
      <div class="wrap section">
        <div class="head-row">
          <div class="stack" style="gap: 16px; max-width: 720px;">
            <p class="eyebrow" aria-hidden="true">{d.h.skills}</p>
            <h2 id="skills-h" class="h2" data-print-title={d.h.skills}><span class="sr-only">{d.h.skills}: </span><span>{T.skillsH}</span></h2>
          </div>
        </div>
        <ul class="grid skills-grid" style="--min: 300px;">
          {d.skills.map((s, i) => (
            <li class={`card${s.name === 'AI-assisted delivery' ? ' card--accent' : ''}`}>
              <h3 class="card__title">{s.name}</h3>
              <ul class="skill-chips">{s.items.map((it) => <li>{it}</li>)}</ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- How I work -->
    <section class="wrap section" id="how" aria-labelledby="how-h" data-print="hide">
      <div class="head-row">
        <div class="stack" style="gap: 16px; max-width: 720px;">
          <p class="eyebrow" aria-hidden="true">{T.howEyebrow}</p>
          <h2 id="how-h" class="h2"><span class="sr-only">{T.howEyebrow}: </span><span>{T.howH}</span></h2>
        </div>
      </div>
      <div class="grid grid--seams" style="--min: 240px;">
        {T.how.map(([title, text], i) => (
          <div class="card card--flat">
            <span class="card__tag">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="card__title">{title}</h3>
            <p class="card__text">{text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Education, certifications, languages -->
    <section class="band" id="education" aria-label={T.credEyebrow}>
      <div class="wrap section">
        <p class="eyebrow cred__eyebrow" aria-hidden="true">{T.credEyebrow}</p>
        <div class="grid cred-grid" style="--min: 300px;">
          <div class="card">
            <h2 class="h2 cred__h">{d.h.education}</h2>
            <ul class="cred">{d.education.map((e) => <li><b>{e.degree}</b><span>{e.school}</span></li>)}</ul>
          </div>
          <div class="card">
            <h2 class="h2 cred__h">{d.h.certifications}</h2>
            <ul class="cred">{d.certifications.map((c) => <li><b>{c.name}</b><code>{c.meta}</code></li>)}</ul>
          </div>
          <div class="card">
            <h2 class="h2 cred__h">{d.h.languages}</h2>
            <ul class="cred">{d.languages.map((l) => <li class="cred__lang"><b>{l.name}</b><span>{l.level}</span></li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact" aria-labelledby="contact-h">
      <div class="wrap section split contact__in">
        <div class="stack contact__text">
          <p class="eyebrow" aria-hidden="true">{T.nav.contact}</p>
          <h2 id="contact-h" class="h2"><span class="sr-only">{T.nav.contact}: </span><span>{T.contactH}</span></h2>
          <p class="muted contact__p">{T.contactP}</p>
          <p class="clock label"><span class="pulse" aria-hidden="true"></span><span>{lang === 'uk' ? 'Ужгород' : 'Uzhhorod'} · <span data-clock>EET (UTC+2/+3)</span></span></p>
        </div>
        <ul class="ctiles">
          {contacts.map((c) => (
            <li><a class={`ctile${'main' in c && c.main ? ' ctile--main' : ''}`} href={c.href}><Icon name={c.key} size={24} /><span class="ctile__k">{c.label}</span><span class="ctile__v">{c.value}</span><span class="ctile__go"><Arrow /></span></a></li>
          ))}
        </ul>
        <div class="btns contact__files">
          <a class="btn" href={f.pdf} download type="application/pdf"><Icon name="download" size={18} /> {T.cvPdf}</a>
          <a class="btn" href={f.docx} download type="application/vnd.openxmlformats-officedocument.wordprocessingml.document"><Icon name="download" size={18} /> {T.cvDocx}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer wrap">
      <div class="footer__about">
        <b class="footer__brand"><Mark /> {CONTACT.name}</b>
        <span>{T.footerAbout}</span>
        <span class="label">{T.footerLine}</span>
      </div>
      <div class="footer__cols">
        <div class="footer__col">
          <span class="label">{T.footerContact}</span>
          {contacts.map((c) => <a href={c.href}>{c.label}</a>)}
        </div>
        <div class="footer__col">
          <span class="label">{T.footerFiles}</span>
          <a href={FILES.en.pdf} download>{T.pdfEn}</a>
          <a href={FILES.en.docx} download>{T.docxEn}</a>
          <a href={FILES.uk.pdf} download>{T.pdfUk}</a>
          <a href={FILES.uk.docx} download>{T.docxUk}</a>
        </div>
        <div class="footer__col">
          <span class="label">{T.footerAlso}</span>
          <a href={CONTACT.tower}>{T.towerSite}</a>
          <a href={CONTACT.towerRepo}>{T.towerRepo}</a>
          <a href={CONTACT.towerNotion}>{T.towerNotion}</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const themeBtn = document.querySelector<HTMLButtonElement>('.theme-btn');
    themeBtn?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#F6F5F1' : '#0E1014');
    });
    const nav = document.querySelector<HTMLElement>('.nav');
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    btn?.addEventListener('click', () => {
      const open = nav?.dataset.open !== 'true';
      if (nav) nav.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
    });
    const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.nav__links a[href^="#"]')].map((a) => [a.getAttribute('href')!.slice(1), a]));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) {
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(e.target.id)?.setAttribute('aria-current', 'true');
      }
    }, { rootMargin: '-40% 0px -55% 0px' });
    links.forEach((_, id) => { const s = document.getElementById(id); if (s) io.observe(s); });
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    const tick = () => {
      if (!clock) return;
      try {
        const time = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Kyiv', hour: '2-digit', minute: '2-digit' }).format(new Date());
        const off = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Kyiv', timeZoneName: 'shortOffset' }).formatToParts(new Date()).find((p) => p.type === 'timeZoneName')?.value?.replace('GMT', 'UTC') ?? '';
        clock.textContent = `${time} · ${off}`;
      } catch {}
    };
    tick(); setInterval(tick, 30000);
    document.querySelectorAll('.nav__links a').forEach((a) => a.addEventListener('click', () => {
      if (nav) nav.dataset.open = 'false';
      btn?.setAttribute('aria-expanded', 'false');
    }));
  </script>
</Base>
